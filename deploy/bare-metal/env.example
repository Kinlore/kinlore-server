# Kinlore on a host without Docker. Copy to kinlore-api/.env and fill in.
# Guide: docs/BARE_METAL.md

APP_NAME=Kinlore
APP_ENV=production
APP_DEBUG=false
APP_KEY=                         # filled by: php artisan key:generate
APP_URL=https://photos.example.com   # the address the phones use; invite and video links are built from it

# Optional: the setup token that the web setup page asks for. Empty: run 'php artisan kinlore:setup-token' to get one.
SETUP_TOKEN=

# Database. SQLite needs no database server and is enough for one family.
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/kinlore/database.sqlite
# PostgreSQL instead:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kinlore
# DB_USERNAME=kinlore
# DB_PASSWORD=

# Photos and videos on the local disk
FILESYSTEM_DISK=seaweedfs
SEAWEEDFS_DRIVER=local
MEDIA_ROOT=/var/lib/kinlore/media
# S3 storage instead: SEAWEEDFS_DRIVER=s3 plus SEAWEEDFS_ENDPOINT, SEAWEEDFS_KEY, SEAWEEDFS_SECRET, SEAWEEDFS_BUCKET

# No Redis needed
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# The reverse proxy on this machine
TRUSTED_PROXIES=127.0.0.1

FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
